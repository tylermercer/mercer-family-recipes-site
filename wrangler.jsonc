{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mercer-fam-recipes",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_date": "2024-12-04",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [],
  // Production is served only on the custom domain; workers.dev is off so a
  // Worker-scoped API token can deploy (the workers.dev subdomain lookup is
  // account-level). Preview URLs stay on for PR deploys.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "familyrecipes.tylermercer.net",
      "zone_name": "tylermercer.net",
      "custom_domain": true
    }
  ]
}
