---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/figtree';
import '@styles/index.scss';
import ThemeToggle from '@components/ThemeToggle.astro';

const title = "Family Recipes";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<!-- Browser chrome matches --color-bg in each theme (see DESIGN.md). -->
		<meta name="theme-color" content="#FFFDF7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#14110C" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.setAttribute('data-theme', stored);
				} else {
					document.documentElement.removeAttribute('data-theme');
				}
			})();
		</script>
	</head>
	<body>
		<slot />
		<footer class="site-footer u-guttered-lg u-hide-on-print">
			<ThemeToggle />
		</footer>
	</body>
</html>

<script>
	import logCommitHash from "lib/logCommitHash";
	// This makes it easy to see which version of the site is being served
	logCommitHash();
</script>

<style>
	.site-footer {
		display: flex;
		justify-content: flex-end;
		padding-block-start: 0;
	}
</style>
