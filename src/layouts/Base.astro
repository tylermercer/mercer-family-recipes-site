---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/figtree';
import '@styles/index.scss';

const SITE_NAME = 'Family Recipes';
const DEFAULT_DESCRIPTION = 'Recipes from across the Mercer family, ready to cook from.';

interface Props {
	/** The page's own title, e.g. a recipe name. Omit on the homepage to use the site name. */
	title?: string;
	description?: string;
	/** "article" for a recipe, "website" for everything else. */
	ogType?: 'website' | 'article';
	/** When the page's content last changed, for article:modified_time. */
	modified?: Date;
	/**
	 * Up to two extra label/value pairs that Slack shows under the description
	 * (twitter:label1/data1, twitter:label2/data2), e.g. { From: 'Mom & Dad' }.
	 */
	details?: Record<string, string>;
	/** Keep the page out of search engines, e.g. the offline fallback. */
	noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, ogType = 'website', modified, details = {}, noindex = false } = Astro.props;
const documentTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const ogTitle = title ?? SITE_NAME;
const detailPairs = Object.entries(details).slice(0, 2);

// Social preview: one static image for every page (public/og-image.png, 1200×600).
// Crawlers need absolute URLs, built from `site` in astro.config.mjs.
const ogImage = new URL('/og-image.png', Astro.site);
const ogImageAlt = 'Family Recipes: the Mercer family cookbook, with an ingredient checklist.';
const pageUrl = new URL(Astro.url.pathname, Astro.site);

// --color-bg for each theme (src/styles/theme.scss).
const themeColors = { light: '#FFFDF7', dark: '#14110C' };
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- Home-screen install. Its icons are the apple-touch-icon art at 192 and 512px. -->
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<!--
			Browser chrome matches --color-bg in each theme (see DESIGN.md). The media queries follow
			the system setting; the script below and ThemeToggle (in NavBar, via syncThemeColorMeta) point both
			tags at the pinned theme's color when there's an override.
		-->
		<meta name="theme-color" content={themeColors.light} media="(prefers-color-scheme: light)"
			data-scheme="light" data-theme-color-light={themeColors.light} data-theme-color-dark={themeColors.dark} />
		<meta name="theme-color" content={themeColors.dark} media="(prefers-color-scheme: dark)"
			data-scheme="dark" data-theme-color-light={themeColors.light} data-theme-color-dark={themeColors.dark} />
		<title>{documentTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />
		{noindex && <meta name="robots" content="noindex" />}

		<!-- Link previews (Slack, Discord, Mattermost, iMessage) read these. -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="600" />
		<meta property="og:image:alt" content={ogImageAlt} />
		{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		{detailPairs.map(([label, data], i) => (
			<Fragment>
				<meta name={`twitter:label${i + 1}`} content={label} />
				<meta name={`twitter:data${i + 1}`} content={data} />
			</Fragment>
		))}
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const theme = stored === 'light' || stored === 'dark' ? stored : null;
				if (theme) {
					document.documentElement.setAttribute('data-theme', theme);
				} else {
					document.documentElement.removeAttribute('data-theme');
				}
				// Same as syncThemeColorMeta (src/utils), inlined for first paint.
				document.querySelectorAll('meta[name="theme-color"][data-scheme]').forEach(function (meta) {
					const color = meta.getAttribute('data-theme-color-' + (theme || meta.dataset.scheme));
					if (color) meta.content = color;
				});
			})();
		</script>
	</head>
	<body>
		<slot />
		{import.meta.env.DEV ? (
			// In dev the worker would cache Vite's bundles and serve stale copies after a re-bundle,
			// so don't register it, and clear out any worker and caches left from a production build.
			<script is:inline>
				if ('serviceWorker' in navigator) {
					navigator.serviceWorker.getRegistrations().then(function (registrations) {
						registrations.forEach(function (registration) { registration.unregister(); });
					});
					if ('caches' in window) {
						caches.keys().then(function (keys) { keys.forEach(function (key) { caches.delete(key); }); });
					}
				}
			</script>
		) : (
			// Offline support (src/service-worker.ts). Pages are network-first, so a new worker taking
			// over doesn't need a reload; skipping it keeps checked-off ingredients in place.
			<script is:inline>
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', function () {
						navigator.serviceWorker.register('/sw.js');
					});
				}
			</script>
		)}
	</body>
</html>

<script>
	import logCommitHash from "lib/logCommitHash";
	// This makes it easy to see which version of the site is being served
	logCommitHash();

	import { getSessionStorage, recordSessionEntry } from '@utils/sessionEntry';
	// The first page of the session, so a recipe's back button knows whether there's a page to go back to.
	recordSessionEntry(getSessionStorage(), location.pathname);
</script>

