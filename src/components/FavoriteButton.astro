---
// Toggles whether this recipe is a favorite (saved in this browser). Hidden until the script runs,
// since it needs localStorage. The label stays "Favorite"; aria-pressed and the filled star carry
// the state, so it isn't color alone.
interface Props {
	recipeId: string;
}

const { recipeId } = Astro.props;
---

<button
	type="button"
	class="favorite-button button-secondary"
	data-recipe-id={recipeId}
	aria-pressed="false"
	hidden
>
	<svg class="star-outline" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
		<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" d="M12 2.8l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 17l-5.8 3.3 1.4-6.4-4.9-4.4 6.5-.7z" />
	</svg>
	<svg class="star-filled" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
		<path fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" d="M12 2.8l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 17l-5.8 3.3 1.4-6.4-4.9-4.4 6.5-.7z" />
	</svg>
	Favorite
</button>

<script>
	import { isFavorite, setFavorite } from '@utils/favorites';

	function render(button: HTMLButtonElement) {
		const id = button.dataset.recipeId!;
		button.setAttribute('aria-pressed', String(isFavorite(id)));
	}

	function initFavoriteButtons() {
		for (const button of document.querySelectorAll<HTMLButtonElement>('.favorite-button')) {
			const id = button.dataset.recipeId;
			if (!id) continue;
			try {
				localStorage.getItem('test');
			} catch {
				continue; // No storage, so nothing to save favorites to.
			}
			render(button);
			button.hidden = false;
			if (button.dataset.ready) continue;
			button.dataset.ready = 'true';
			button.addEventListener('click', () => {
				const next = button.getAttribute('aria-pressed') !== 'true';
				button.setAttribute('aria-pressed', String(setFavorite(id, next)));
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initFavoriteButtons);
	} else {
		initFavoriteButtons();
	}

	// A page restored from the back/forward cache may show a stale state.
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) initFavoriteButtons();
	});
</script>

<style>
	.favorite-button {
		align-self: flex-start;
	}

	.favorite-button svg {
		flex: none;
	}

	.star-filled,
	.favorite-button[aria-pressed='true'] .star-outline {
		display: none;
	}

	.favorite-button[aria-pressed='true'] .star-filled {
		display: inline;
	}

	/* Same "chosen" look as the scale presets: accent fill, with the filled star as the non-color cue. */
	.favorite-button[aria-pressed='true'] {
		background-color: var(--color-accent);
		color: var(--color-on-accent);
	}
</style>
