---
import type { CollectionEntry } from 'astro:content';
import { recipeTitleTransitionName } from '@utils/recipeTitleTransitionName';

interface Props {
	recipes: CollectionEntry<'recipes'>[];
	/** Show each recipe's contributor. Off on a single contributor's page, where it's redundant. */
	showContributor?: boolean;
	/** Move the recipes favorited in this browser to the top (done client-side, from localStorage). */
	favoritesFirst?: boolean;
}

const { recipes, showContributor = true, favoritesFirst = false } = Astro.props;

const isWip = (title: string) => /\(wip\)/i.test(title);
const byTitle = (a: CollectionEntry<'recipes'>, b: CollectionEntry<'recipes'>) =>
	a.data.title.localeCompare(b.data.title);

// Work-in-progress recipes go last.
const sortedRecipes = [
	...recipes.filter((r) => !isWip(r.data.title)).sort(byTitle),
	...recipes.filter((r) => isWip(r.data.title)).sort(byTitle),
];
---

{sortedRecipes.length === 0 ? (
	<p>No recipes found.</p>
) : (
	<ul class="recipe-list u-list-bare" data-favorites-first={favoritesFirst ? '' : undefined}>
		{sortedRecipes.map((recipe) => {
			const wip = isWip(recipe.data.title);
			const meta = [
				showContributor ? recipe.data.contributor : undefined,
				recipe.data.lastModified
					? `Last modified ${new Date(recipe.data.lastModified).toLocaleDateString()}`
					: undefined,
			].filter(Boolean);
			return (
				<li class="recipe-row" data-recipe-id={recipe.id}>
					<a class="recipe-title" href={`/${recipe.id}`} data-transition-name={recipeTitleTransitionName(recipe.id)}>{recipe.data.title}</a>
					<!-- After the title, so favorite titles stay aligned with the rest. -->
					<svg class="favorite-mark" role="img" aria-label="Favorite" viewBox="0 0 24 24" width="18" height="18">
						<path fill="currentColor" d="M12 2.8l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 17l-5.8 3.3 1.4-6.4-4.9-4.4 6.5-.7z" />
					</svg>
					{wip && <span class="u-chip u-step--2">Work in progress</span>}
					{meta.length > 0 && <p class="u-label">{meta.join(' • ')}</p>}
				</li>
			);
		})}
	</ul>
)}

<!--
	The tapped recipe's title moves into the recipe page's heading, and back again, using the
	@view-transition rule in base.scss. Only that one title gets a view-transition-name (set as the
	page is left or revealed), since naming every row would capture each one as its own layer. Inline
	and right after the list, so the listeners exist before pagereveal fires on a back navigation;
	if one is ever missed, the page just cross-fades as usual.
-->
<script is:inline>
	(function () {
		if (window.__recipeTitleTransitions) return;
		window.__recipeTitleTransitions = true;

		function trim(path) {
			return path.replace(/\/+$/, '') || '/';
		}

		function titleLinkFor(url) {
			if (!url) return null;
			var target = new URL(url, location.href);
			if (target.origin !== location.origin) return null;
			var links = document.querySelectorAll('a.recipe-title[data-transition-name]');
			for (var i = 0; i < links.length; i++) {
				if (trim(new URL(links[i].href).pathname) === trim(target.pathname)) return links[i];
			}
			return null;
		}

		function clearNames() {
			document.querySelectorAll('a.recipe-title[data-transition-name]').forEach(function (link) {
				link.style.viewTransitionName = '';
			});
		}

		function nameFor(link, transition) {
			link.style.viewTransitionName = link.dataset.transitionName;
			transition.finished.finally(clearNames);
		}

		// Leaving for a recipe: name the title that was tapped.
		window.addEventListener('pageswap', function (event) {
			if (!event.viewTransition || !event.activation || !event.activation.entry) return;
			var link = titleLinkFor(event.activation.entry.url);
			if (link) nameFor(link, event.viewTransition);
		});

		// Coming back from a recipe: name its title so the heading moves back into place.
		window.addEventListener('pagereveal', function (event) {
			clearNames();
			if (!event.viewTransition || !window.navigation || !navigation.activation) return;
			var from = navigation.activation.from;
			var link = titleLinkFor(from && from.url);
			if (link) nameFor(link, event.viewTransition);
		});
	})();
</script>

<script>
	import { favoritesFirst, getFavorites } from '@utils/favorites';

	/**
	 * Marks favorited recipes with a star, and in lists that ask for it, moves them to the top in
	 * their existing (alphabetical) order. Favorites live in this browser's localStorage.
	 */
	function applyFavorites() {
		const favorites = new Set(getFavorites());
		for (const list of document.querySelectorAll<HTMLElement>('.recipe-list')) {
			const rows = [...list.querySelectorAll<HTMLElement>(':scope > .recipe-row')];
			for (const row of rows) row.classList.toggle('is-favorite', favorites.has(row.dataset.recipeId ?? ''));
			if (!list.hasAttribute('data-favorites-first')) continue;
			// Restore the server order first, so un-favorited recipes go back where they were.
			rows.sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
			list.append(...favoritesFirst(rows, (row) => row.dataset.recipeId ?? '', favorites));
		}
	}

	function init() {
		for (const list of document.querySelectorAll<HTMLElement>('.recipe-list')) {
			list.querySelectorAll<HTMLElement>(':scope > .recipe-row').forEach((row, i) => {
				row.dataset.order ??= String(i);
			});
		}
		applyFavorites();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}

	// Coming back from a recipe page (often from the back/forward cache) should reflect any change.
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) applyFavorites();
	});
	window.addEventListener('storage', applyFavorites);
</script>

<style>
	/* Borderless rows separated by a small gap; the whole row tints on hover (DESIGN.md). */
	.recipe-list {
		display: grid;
		gap: var(--space-3xs);
		/* Hang the row padding outside the column so titles align with headings. */
		margin-inline: calc(-1 * var(--space-xs));
	}

	.recipe-row {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.2em 0.6em;
		padding: var(--space-2xs) var(--space-xs);
	}

	.recipe-row:hover,
	.recipe-row:focus-within {
		background-color: var(--color-accent-soft);
	}

	.recipe-row .u-label {
		flex-basis: 100%;
		/* Regular weight: the bold titles already carry the list. */
		font-weight: 400;
	}

	/* Shown only for favorites; accent-strong meets the 3:1 non-text contrast on the page. */
	.favorite-mark {
		display: none;
		flex: none;
		color: var(--color-accent-strong);
	}

	.recipe-row.is-favorite .favorite-mark {
		display: inline;
	}

	.recipe-title {
		font-family: var(--font-heading);
		font-size: var(--step-1);
		font-weight: 700;
		line-height: var(--lh-1);
		color: var(--color-text);
		text-decoration: none;
	}

	/* Whole row is the link target. */
	.recipe-title::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.recipe-title:hover,
	.recipe-title:focus-visible {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}
</style>
