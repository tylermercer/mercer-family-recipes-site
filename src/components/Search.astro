---
// Site search via Pagefind's Component UI. The /pagefind/ bundle is generated from the built
// site by `pagefind --site dist/client` (see the build script), so search only works on a full
// build, not under `astro dev`.
---

<!-- One wrapper element, so the search counts as a single item in flex layouts like the nav. -->
<div class="site-search">
	<link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
	<script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>

	<pagefind-config bundle-path="/pagefind/"></pagefind-config>
	<pagefind-modal-trigger placeholder="Search recipes"></pagefind-modal-trigger>
	<pagefind-modal></pagefind-modal>
</div>

<style is:global>
	/*
	 * Pagefind sets its defaults on :root, unlayered. html:root outranks that. Values follow
	 * DESIGN.md: tokens for color, square corners, no shadows, and borders only on the inputs.
	 */
	html:root {
		--pf-font: var(--font-body);
		--pf-text: var(--color-text);
		--pf-text-secondary: var(--color-text-muted);
		--pf-text-muted: var(--color-text-muted);
		--pf-background: var(--color-bg);
		--pf-border: var(--color-border);
		--pf-border-focus: var(--color-focus);
		--pf-border-radius: 0;
		--pf-hover: var(--color-accent-soft);
		--pf-mark: var(--color-accent-strong);
		--pf-outline-focus: var(--color-focus);
		--pf-outline-width: 3px;
		--pf-shadow-sm: none;
		--pf-shadow-md: none;
		--pf-shadow-lg: none;
		--pf-skeleton: var(--color-surface);
		--pf-skeleton-shine: var(--color-accent-soft);
		--pf-scroll-shadow: transparent;
	}

	/* Borderless results: cards, chips, and footer separate by fill and spacing. */
	pagefind-modal {
		--pf-border: transparent;
	}

	/* The search field keeps a full-contrast edge: the trigger, and the input bar in the modal. */
	pagefind-modal .pf-modal-header {
		--pf-border: var(--color-border);
	}

	/* Pagefind hard-codes these radii instead of using --pf-border-radius. */
	pagefind-modal :is(dialog.pf-modal, .pf-modal-close) {
		border-radius: 0 !important;
	}

	/*
	 * Full width of the guttered column it sits in. The button is already 100% wide; this widens
	 * its host, which Pagefind's later-loading stylesheet sets to inline-block.
	 */
	.site-search pagefind-modal-trigger {
		display: block;
	}

	pagefind-modal-trigger .pf-trigger-btn {
		border-width: 2px !important;
		font-family: var(--font-body);
	}
</style>
