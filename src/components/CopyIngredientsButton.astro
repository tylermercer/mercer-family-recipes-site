---
// Copies the recipe's ingredient checklists as plain text. Hidden until the script finds a
// checklist and the Clipboard API, so it never shows as a dead button.
---

<button id="copy-ingredients-btn" type="button" class="button-secondary copy-ingredients" hidden>
  Copy ingredient list
</button>
<span id="copy-ingredients-status" class="u-sr-only" role="status"></span>

<script>
  import { ingredientListText } from '@utils/ingredientListText';

  const LABEL = 'Copy ingredient list';
  const RESET_AFTER_MS = 2000;

  function initCopyIngredients() {
    const button = document.querySelector<HTMLButtonElement>('#copy-ingredients-btn');
    const status = document.querySelector('#copy-ingredients-status');
    const content = document.querySelector('.e-content');
    if (!button || !status || !content || !navigator.clipboard?.writeText) return;
    if (!ingredientListText(content)) return;

    button.hidden = false;
    button.closest('details')?.removeAttribute('hidden');
    let resetTimer: number | undefined;

    function show(message: string) {
      button!.textContent = message;
      status!.textContent = message;
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button!.textContent = LABEL;
        status!.textContent = '';
      }, RESET_AFTER_MS);
    }

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(ingredientListText(content));
        show('Copied!');
      } catch (e) {
        console.error('Failed to copy the ingredient list', e);
        show("Couldn't copy");
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCopyIngredients);
  } else {
    initCopyIngredients();
  }
</script>

<style>
  /* Wide enough for "Copy ingredient list", so the shorter "Copied!" doesn't shift the row. */
  .copy-ingredients {
    min-inline-size: 11.5em;
  }
</style>
