---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Base.astro';
import NavBar from '@components/NavBar.astro';
import RecipeList from '@components/RecipeList.astro';
import { tagSlug } from '@utils/tags';

export async function getStaticPaths() {
	const allRecipes = await getCollection('recipes');
	const recipesByTag = new Map<string, { tag: string; recipes: typeof allRecipes }>();
	for (const recipe of allRecipes) {
		for (const tag of recipe.data.tags) {
			const slug = tagSlug(tag);
			if (!recipesByTag.has(slug)) recipesByTag.set(slug, { tag, recipes: [] });
			recipesByTag.get(slug)!.recipes.push(recipe);
		}
	}
	return [...recipesByTag].map(([slug, props]) => ({ params: { tag: slug }, props }));
}

const { tag, recipes } = Astro.props;
---

<Layout
	title={`Recipes tagged “${tag}”`}
	description={`Mercer family recipes tagged #${tag}.`}
>
	<main class="u-guttered l-stack l-space-xl">
		<NavBar>
			<nav>
				<a href="/" role="button">&larr; Back to all recipes</a>
			</nav>
		</NavBar>
		<section class="l-stack l-space-m">
			<h1>Recipes tagged “{tag}”</h1>
			<RecipeList recipes={recipes} />
		</section>
	</main>
</Layout>
