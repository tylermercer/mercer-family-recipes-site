---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Base.astro';
import Search from '@components/Search.astro';
import RecipeList from '@components/RecipeList.astro';
import { CONTRIBUTORS } from '@utils/contributors';
import { contributorPath } from '@utils/contributorSlug';
import { tagPath, tagSlug } from '@utils/tags';

const allRecipes = await getCollection('recipes');

// Families in their canonical order, skipping any with no recipes yet.
const families = CONTRIBUTORS.map((contributor) => ({
	contributor,
	count: allRecipes.filter((r) => r.data.contributor === contributor).length,
})).filter((f) => f.count > 0);

// Tags alphabetically, with how many recipes have each.
const tagCounts = new Map<string, { tag: string; count: number }>();
for (const recipe of allRecipes) {
	for (const tag of recipe.data.tags) {
		const entry = tagCounts.get(tagSlug(tag)) ?? { tag, count: 0 };
		entry.count++;
		tagCounts.set(tagSlug(tag), entry);
	}
}
const tags = [...tagCounts.values()].sort((a, b) => a.tag.localeCompare(b.tag));
---

<Layout>
	<main class="u-guttered l-stack l-space-xl">
		<header class="l-stack l-space-s">
			<h1>Family Recipes</h1>
			<p class="u-step-1">Recipes from the Mercer family, synced from Google Drive.</p>
			<Search />
		</header>

		{(families.length > 0 || tags.length > 0) && (
			<section class="l-stack l-space-s" aria-label="Browse recipes">
				{families.length > 0 && (
					<details class="browse">
						<summary><h2 class="browse-heading">By family</h2></summary>
						<ul class="l-cluster l-space-2xs u-list-bare browse-list">
							{families.map(({ contributor, count }) => (
								<li>
									<a class="u-chip" href={contributorPath(contributor)}>
										{contributor}&nbsp;<span class="browse-count">({count})</span>
									</a>
								</li>
							))}
						</ul>
					</details>
				)}
				{tags.length > 0 && (
					<details class="browse">
						<summary><h2 class="browse-heading">By tag</h2></summary>
						<ul class="l-cluster l-space-2xs u-list-bare browse-list">
							{tags.map(({ tag, count }) => (
								<li>
									<a class="u-chip" href={tagPath(tag)}>
										#{tag}&nbsp;<span class="browse-count">({count})</span>
									</a>
								</li>
							))}
						</ul>
					</details>
				)}
			</section>
		)}

		<section class="l-stack l-space-s" aria-labelledby="all-recipes-heading">
			<h2 id="all-recipes-heading">All recipes</h2>
			<RecipeList recipes={allRecipes} />
		</section>
	</main>
</Layout>

<style>
	/* Keep the heading on the same line as the disclosure marker. */
	.browse-heading {
		display: inline;
		font-size: var(--step-1);
		line-height: var(--lh-1);
	}

	.browse-list {
		margin-block-start: var(--space-2xs);
		padding-inline-start: 1.1em;
	}

	.browse-count {
		color: var(--color-text-muted);
		font-weight: 500;
	}

	a:hover .browse-count {
		color: var(--color-text-muted);
	}
</style>
