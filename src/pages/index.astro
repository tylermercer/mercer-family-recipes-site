---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Base.astro';
import NavBar from '@components/NavBar.astro';
import Search from '@components/Search.astro';
import RecipeList from '@components/RecipeList.astro';
import { CONTRIBUTORS } from '@utils/contributors';
import { contributorPath } from '@utils/contributorSlug';
import { countTags, tagPath } from '@utils/tags';

const allRecipes = await getCollection('recipes');

// Families in their canonical order, skipping any with no recipes yet.
const families = CONTRIBUTORS.map((contributor) => ({
	contributor,
	count: allRecipes.filter((r) => r.data.contributor === contributor).length,
})).filter((f) => f.count > 0);

// Tags, most-used first. The first few are always shown; the rest sit behind "Show all".
const VISIBLE_TAG_COUNT = 5;
const tags = countTags(allRecipes.map((r) => r.data.tags));
---

<Layout>
	<main class="u-guttered l-stack l-space-xl">
		<header class="u-hero l-stack l-space-s">
			<NavBar>
				<h1>Family<br>Recipes</h1>
			</NavBar>
			<p class="u-step-1">Recipes from the Mercer family, synced from Google Drive.</p>
			<Search />
		</header>

		{families.length > 0 && (
			<section class="l-stack l-space-2xs" aria-labelledby="by-family-heading">
				<h2 id="by-family-heading" class="browse-heading">By family</h2>
				<ul class="l-cluster l-space-2xs u-list-bare">
					{families.map(({ contributor, count }) => (
						<li>
							<a class="u-chip" href={contributorPath(contributor)}>
								{contributor}&nbsp;<span class="browse-count">({count})</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		{tags.length > 0 && (
			<section class="l-stack l-space-2xs" aria-labelledby="by-tag-heading">
				<h2 id="by-tag-heading" class="browse-heading">By tag</h2>
				<ul class="l-cluster l-space-2xs u-list-bare" id="tag-list">
					{tags.map(({ tag, count }, i) => (
						<li class:list={{ 'tag-extra': i >= VISIBLE_TAG_COUNT }} hidden={i >= VISIBLE_TAG_COUNT}>
							<a class="u-chip" href={tagPath(tag)}>
								#{tag}&nbsp;<span class="browse-count">({count})</span>
							</a>
						</li>
					))}
					{tags.length > VISIBLE_TAG_COUNT && (
						<li>
							<button
								type="button"
								class="button-secondary"
								id="tag-toggle"
								aria-expanded="false"
								aria-controls="tag-list"
								hidden
							>
								Show all
							</button>
						</li>
					)}
				</ul>
				{/* Without JS the toggle can't work, so show every tag. */}
				<noscript set:html="<style>.tag-extra { display: list-item !important; }</style>" />
			</section>
		)}

		<section class="l-stack l-space-s" aria-labelledby="all-recipes-heading">
			<h2 id="all-recipes-heading">All recipes</h2>
			<RecipeList recipes={allRecipes} favoritesFirst />
		</section>
	</main>
</Layout>

<style>
	.browse-heading {
		font-size: var(--step-1);
		line-height: var(--lh-1);
	}

	.browse-count {
		color: var(--color-text-muted);
		font-weight: 500;
	}

	a:hover .browse-count {
		color: var(--color-text-muted);
	}
</style>

<script>
	// "Show all" / "Hide all" for the tags beyond the first few.
	const toggle = document.getElementById('tag-toggle');
	const extras = document.querySelectorAll<HTMLElement>('#tag-list .tag-extra');
	if (toggle && extras.length > 0) {
		toggle.hidden = false;
		toggle.addEventListener('click', () => {
			const expanded = toggle.getAttribute('aria-expanded') !== 'true';
			toggle.setAttribute('aria-expanded', String(expanded));
			toggle.textContent = expanded ? 'Hide all' : 'Show all';
			extras.forEach((el) => (el.hidden = !expanded));
		});
	}
</script>
