---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Base.astro';

const allRecipes = await getCollection('recipes');

const isWip = (title: string) => /\(wip\)/i.test(title);

const regularRecipes = allRecipes
	.filter((r) => !isWip(r.data.title))
	.sort((a, b) => a.data.title.localeCompare(b.data.title));

const wipRecipes = allRecipes
	.filter((r) => isWip(r.data.title))
	.sort((a, b) => a.data.title.localeCompare(b.data.title));

const sortedRecipes = [...regularRecipes, ...wipRecipes];
---

<Layout>
	<main class="u-guttered-lg l-stack l-space-xl">
		<section class="l-center l-space-m">
			<h1>Family Recipes</h1>
			<p class="u-step-1">
				A collection of recipes synced directly from Google Drive.
			</p>
		</section>

		<section class="l-space-m">
			{sortedRecipes.length === 0 ? (
				<div class="l-box">
					<p>No recipes found.</p>
				</div>
			) : (
				<ul class="l-stack l-space-s" style="list-style-type: none; padding: 0;">
					{sortedRecipes.map((recipe) => {
						const wip = isWip(recipe.data.title);
						return (
							<li class="l-box">
								<div class="l-cluster" style="align-items: center; justify-content: space-between; gap: 0.5rem;">
									<a href={`/${recipe.id}`} style="font-weight: bold; font-size: 1.25rem;">
										{recipe.data.title}
									</a>
									{wip && (
										<span class="u-step--1" style="background-color: var(--gray-5); color: var(--gray-12); padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid var(--gray-7); text-transform: lowercase;">
											work in progress
										</span>
									)}
								</div>
								{recipe.data.lastModified && (
									<p class="u-step--1" style="margin-top: 0.25rem; opacity: 0.8;">
										Last modified: {new Date(recipe.data.lastModified).toLocaleDateString()}
									</p>
								)}
							</li>
						);
					})}
				</ul>
			)}
		</section>
	</main>
</Layout>
