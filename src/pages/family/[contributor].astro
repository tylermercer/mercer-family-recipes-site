---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Base.astro';
import RecipeList from '@components/RecipeList.astro';
import { CONTRIBUTORS } from '@utils/contributors';
import { contributorSlug } from '@utils/contributorSlug';

export async function getStaticPaths() {
	const allRecipes = await getCollection('recipes');
	return CONTRIBUTORS.map((contributor) => ({
		params: { contributor: contributorSlug(contributor) },
		props: {
			contributor,
			recipes: allRecipes.filter((r) => r.data.contributor === contributor),
		},
	})).filter(({ props }) => props.recipes.length > 0);
}

const { contributor, recipes } = Astro.props;
---

<Layout>
	<main class="u-guttered-lg l-stack l-space-xl">
		<nav class="l-space-s">
			<a href="/" role="button">&larr; Back to all recipes</a>
		</nav>
		<section class="l-space-m">
			<h1>{contributor}'s recipes</h1>
			<RecipeList recipes={recipes} showContributor={false} />
		</section>
	</main>
</Layout>
