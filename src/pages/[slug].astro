---
import { getCollection, getEntries, render } from 'astro:content';
import Layout from '@layouts/Base.astro';
import NavBar from '@components/NavBar.astro';
import KeepAwakeToggle from '@components/KeepAwakeToggle.astro';
import FavoriteButton from '@components/FavoriteButton.astro';
import CopyIngredientsButton from '@components/CopyIngredientsButton.astro';
import RecipeScaler from '@components/RecipeScaler.astro';
import ShareButton from '@components/ShareButton.astro';
import { contributorPath } from '@utils/contributorSlug';
import { tagPath } from '@utils/tags';
import { recipeDescription } from '@utils/recipeDescription';
import { recipeTitleTransitionName } from '@utils/recipeTitleTransitionName';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  if (recipes.length === 0) {
    return [
      {
        params: { slug: 'sample-recipe' },
        props: {
          recipe: {
            id: 'sample-recipe',
            data: {
              title: "Grandma's Chocolate Chip Cookies",
              lastModified: new Date(),
              driveUrl: 'https://docs.google.com/document/d/sample/edit',
            },
            isMock: true,
          },
        },
      },
    ];
  }
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
// Shown in one line, separated by bullets.
const metaParts = (['contributor', 'lastModified', 'driveUrl'] as const).filter(
	(key) => recipe.data[key],
);
// Link-preview metadata: who it's from and its first ingredients.
const description = recipe.isMock ? undefined : recipeDescription(recipe.data.contributor, recipe.rendered?.html ?? '');
const details: Record<string, string> = {};
if (recipe.data.contributor) details.From = recipe.data.contributor;
if (recipe.data.tags?.length) details.Tags = recipe.data.tags.map((tag: string) => `#${tag}`).join(' ');
let Content = null;
let relatedRecipes: Awaited<ReturnType<typeof getEntries<'recipes'>>> = [];
if (!recipe.isMock) {
  const rendered = await render(recipe);
  Content = rendered.Content;
  relatedRecipes = await getEntries(recipe.data.relatedRecipes ?? []);
}
---

<Layout
	title={recipe.data.title}
	description={description}
	ogType="article"
	modified={new Date(recipe.data.lastModified)}
	details={details}
>
	<main class="u-guttered l-stack l-space-l">
		<article class="l-stack l-space-m recipe-content" data-pagefind-body>
			<!-- The navbar lives in the article header so the title band can sit behind both. -->
			<header class="u-hero l-stack l-space-2xs">
				<div class="recipe-navbar" data-pagefind-ignore>
					<NavBar>
						<nav class="u-hide-on-print">
							<a href="/" role="button" data-back-link>&larr; All recipes</a>
						</nav>
						<ShareButton slot="actions" title={recipe.data.title} />
					</NavBar>
				</div>
				<!-- Shares a view-transition-name with this recipe's title in the lists, so it moves between them. -->
				<h1 data-pagefind-meta="title" class="recipe-heading" style={`view-transition-name: ${recipeTitleTransitionName(recipe.id)}`}>{recipe.data.title}</h1>
				<p class="u-label" data-pagefind-ignore>
					{metaParts.map((part, i) => (
						<Fragment>
							{i > 0 && ' • '}
							{part === 'contributor' && (
								<span>From <a href={contributorPath(recipe.data.contributor)} data-pagefind-filter="family">{recipe.data.contributor}</a></span>
							)}
							{part === 'lastModified' && (
								<span>Last modified {new Date(recipe.data.lastModified).toLocaleDateString()}</span>
							)}
							{part === 'driveUrl' && (
								<a class="u-hide-on-print" href={recipe.data.driveUrl} target="_blank" rel="noopener noreferrer">View Google Doc</a>
							)}
						</Fragment>
					))}
				</p>
				{recipe.data.tags?.length > 0 && (
					<ul class="l-cluster l-space-2xs u-list-bare u-hide-on-print" aria-label="Tags" data-pagefind-ignore>
						{recipe.data.tags.map((tag: string) => (
							<li><a class="u-chip" href={tagPath(tag)} data-pagefind-filter="tag[data-tag]" data-tag={tag}>#{tag}</a></li>
						))}
					</ul>
				)}
				<div class="u-hide-on-print" data-pagefind-ignore>
					<FavoriteButton recipeId={recipe.id} />
				</div>
			</header>
			<div class="recipe-tools l-stack l-space-2xs u-hide-on-print" data-pagefind-ignore>
				<RecipeScaler />
				<div class="l-cluster l-space-m recipe-tools-row">
					<KeepAwakeToggle />
					<!-- Shown once a script reveals one of the buttons inside. -->
					<details class="recipe-more" hidden>
						<summary>More options</summary>
						<div class="l-cluster l-space-2xs recipe-more-buttons">
							<CopyIngredientsButton />
							<button id="reset-checklist-btn" type="button" class="button-secondary" hidden>
								Reset checklist
							</button>
						</div>
					</details>
				</div>
			</div>
			<p id="recipe-scaler-note" class="u-label u-hide-on-print" hidden>
				Only the ingredient list is scaled. Adjust amounts in the steps, cooking times, and pan sizes yourself.
			</p>
			<div class="e-content l-prose">
				{Content ? <Content /> : (
					<div>
						<p>Ingredients:</p>
						<ul class="contains-task-list">
							<li class="task-list-item"><input type="checkbox" disabled /> 1 cup flour</li>
							<li class="task-list-item"><input type="checkbox" disabled /> 1/2 cup sugar</li>
						</ul>
						<p>1. Mix ingredients.<br/>2. Bake at 350°F for 10 minutes.<br/>3. Enjoy!</p>
					</div>
				)}
			</div>
			{relatedRecipes.length > 0 && (
				<section class="l-stack l-space-2xs u-hide-on-print" aria-labelledby="see-also-heading" data-pagefind-ignore>
					<h2 id="see-also-heading">See also</h2>
					<ul>
						{relatedRecipes.map((related) => (
							<li><a href={`/${related.id}`}>{related.data.title}</a></li>
						))}
					</ul>
				</section>
			)}
		</article>
	</main>

	<script>
		import { getSessionStorage, shouldNavigateBack } from '@utils/sessionEntry';

		// Back to wherever the recipe was opened from (a tag page, a search, another recipe), like an
		// app's back button, and labeled "Back" since that may not be the homepage. On the session's
		// first page there's nothing of ours behind it, so it stays a link to "All recipes".
		const backLink = document.querySelector<HTMLAnchorElement>('a[data-back-link]');
		if (backLink && shouldNavigateBack(getSessionStorage(), location.pathname, history.length)) {
			backLink.textContent = '← Back';
			backLink.addEventListener('click', (event) => {
				// Modified clicks (new tab or window) still follow the link.
				if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				history.back();
			});
		}
	</script>

	<script>
		function initCheckboxes() {
			const contentContainer = document.querySelector('.e-content');
			if (!contentContainer) return;

			const checkboxes = contentContainer.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
			if (checkboxes.length === 0) return;

			const resetBtn = document.getElementById('reset-checklist-btn');
			if (resetBtn) {
				resetBtn.hidden = false;
				resetBtn.closest('details')?.removeAttribute('hidden');
			}

			const storageKey = `recipe-checkboxes-${window.location.pathname}`;
			let savedStates: Record<number, boolean> = {};

			try {
				const stored = localStorage.getItem(storageKey);
				if (stored) {
					savedStates = JSON.parse(stored);
				}
			} catch (e) {
				console.error('Failed to load checkbox states from localStorage', e);
			}

			checkboxes.forEach((checkbox, index) => {
				checkbox.disabled = false;
				checkbox.checked = Boolean(savedStates[index]);

				// The whole ingredient row is the hit target, not just the box (DESIGN.md).
				const row = checkbox.closest('.task-list-item');
				row?.addEventListener('click', (event) => {
					const target = event.target as HTMLElement;
					if (target === checkbox || target.closest('a, input, button')) return;
					// Clicks on nested notes under an ingredient don't toggle it.
					if (target.closest('ul, ol') !== row.parentElement) return;
					checkbox.checked = !checkbox.checked;
					checkbox.dispatchEvent(new Event('change'));
				});

				checkbox.addEventListener('change', () => {
					savedStates[index] = checkbox.checked;
					try {
						localStorage.setItem(storageKey, JSON.stringify(savedStates));
					} catch (e) {
						console.error('Failed to save checkbox states to localStorage', e);
					}
				});
			});

			if (resetBtn) {
				resetBtn.addEventListener('click', () => {
					checkboxes.forEach((checkbox, index) => {
						checkbox.checked = false;
						savedStates[index] = false;
					});
					try {
						localStorage.removeItem(storageKey);
					} catch (e) {
						console.error('Failed to clear checkbox states from localStorage', e);
					}
				});
			}
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initCheckboxes);
		} else {
			initCheckboxes();
		}
	</script>
</Layout>

<style>
	/* Hug the text, like the list title it animates from, so the box morphs between the two words
	   rather than from a short link to the full column width. */
	.recipe-heading {
		inline-size: fit-content;
	}

	/* Same gap below the navbar as the page used to have before it moved into the header. */
	.recipe-navbar {
		margin-block-end: calc(var(--space-l) - var(--space-2xs));
	}

	.recipe-tools-row {
		align-items: flex-start;
		row-gap: 0;
	}

	.recipe-more > summary {
		display: inline-flex;
		align-items: center;
		min-block-size: 44px;
		font-size: var(--step--1);
	}

	.recipe-more-buttons {
		padding-inline-start: 1.1em;
	}
</style>
