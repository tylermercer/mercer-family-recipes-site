---
import { getCollection, render } from 'astro:content';
import Layout from '@layouts/Base.astro';
import KeepAwakeToggle from '@components/KeepAwakeToggle.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  if (recipes.length === 0) {
    return [
      {
        params: { slug: 'sample-recipe' },
        props: {
          recipe: {
            id: 'sample-recipe',
            data: {
              title: "Grandma's Chocolate Chip Cookies",
              lastModified: new Date(),
            },
            isMock: true,
          },
        },
      },
    ];
  }
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
let Content = null;
if (!recipe.isMock) {
  const rendered = await render(recipe);
  Content = rendered.Content;
}
---

<Layout>
	<main class="u-guttered-lg l-stack l-space-xl">
		<nav class="l-space-s">
			<a href="/" role="button">&larr; Back to all recipes</a>
		</nav>
		<article class="l-space-m recipe-content">
			<h1>{recipe.data.title}</h1>
			{recipe.data.lastModified && (
				<p class="u-step--1" style="opacity: 0.8; margin-bottom: 1.5rem;">
					Last modified: {new Date(recipe.data.lastModified).toLocaleDateString()}
				</p>
			)}
			<div style="margin-bottom: 1.5rem;">
				<KeepAwakeToggle />
			</div>
			<div class="e-content">
				{Content ? <Content /> : <p>1. Mix ingredients.<br/>2. Bake at 350°F for 10 minutes.<br/>3. Enjoy!</p>}
			</div>
		</article>
	</main>
</Layout>
