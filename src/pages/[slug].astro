---
import { getCollection, getEntries, render } from 'astro:content';
import Layout from '@layouts/Base.astro';
import KeepAwakeToggle from '@components/KeepAwakeToggle.astro';
import { contributorPath } from '@utils/contributorSlug';
import { tagPath } from '@utils/tags';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  if (recipes.length === 0) {
    return [
      {
        params: { slug: 'sample-recipe' },
        props: {
          recipe: {
            id: 'sample-recipe',
            data: {
              title: "Grandma's Chocolate Chip Cookies",
              lastModified: new Date(),
              driveUrl: 'https://docs.google.com/document/d/sample/edit',
            },
            isMock: true,
          },
        },
      },
    ];
  }
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
// Shown in one line, separated by bullets.
const metaParts = (['contributor', 'lastModified', 'driveUrl'] as const).filter(
	(key) => recipe.data[key],
);
let Content = null;
let relatedRecipes: Awaited<ReturnType<typeof getEntries<'recipes'>>> = [];
if (!recipe.isMock) {
  const rendered = await render(recipe);
  Content = rendered.Content;
  relatedRecipes = await getEntries(recipe.data.relatedRecipes ?? []);
}
---

<Layout>
	<main class="u-guttered l-stack l-space-l">
		<nav class="u-hide-on-print">
			<a href="/" role="button">&larr; All recipes</a>
		</nav>
		<article class="l-stack l-space-m recipe-content" data-pagefind-body>
			<header class="l-stack l-space-2xs">
				<h1 data-pagefind-meta="title">{recipe.data.title}</h1>
				<p class="u-label" data-pagefind-ignore>
					{metaParts.map((part, i) => (
						<Fragment>
							{i > 0 && ' • '}
							{part === 'contributor' && (
								<span>From <a href={contributorPath(recipe.data.contributor)} data-pagefind-filter="family">{recipe.data.contributor}</a></span>
							)}
							{part === 'lastModified' && (
								<span>Last modified {new Date(recipe.data.lastModified).toLocaleDateString()}</span>
							)}
							{part === 'driveUrl' && (
								<a class="u-hide-on-print" href={recipe.data.driveUrl} target="_blank" rel="noopener noreferrer">View Google Doc</a>
							)}
						</Fragment>
					))}
				</p>
				{recipe.data.tags?.length > 0 && (
					<ul class="l-cluster l-space-2xs u-list-bare u-hide-on-print" aria-label="Tags" data-pagefind-ignore>
						{recipe.data.tags.map((tag: string) => (
							<li><a class="u-chip" href={tagPath(tag)} data-pagefind-filter="tag[data-tag]" data-tag={tag}>#{tag}</a></li>
						))}
					</ul>
				)}
			</header>
			<div class="l-cluster l-space-2xs u-hide-on-print" data-pagefind-ignore>
				<KeepAwakeToggle />
				<button id="reset-checklist-btn" type="button" class="button-secondary" hidden>
					Reset checklist
				</button>
			</div>
			<div class="e-content l-prose">
				{Content ? <Content /> : (
					<div>
						<p>Ingredients:</p>
						<ul class="contains-task-list">
							<li class="task-list-item"><input type="checkbox" disabled /> 1 cup flour</li>
							<li class="task-list-item"><input type="checkbox" disabled /> 1/2 cup sugar</li>
						</ul>
						<p>1. Mix ingredients.<br/>2. Bake at 350°F for 10 minutes.<br/>3. Enjoy!</p>
					</div>
				)}
			</div>
			{relatedRecipes.length > 0 && (
				<section class="l-stack l-space-2xs u-hide-on-print" aria-labelledby="see-also-heading" data-pagefind-ignore>
					<h2 id="see-also-heading">See also</h2>
					<ul>
						{relatedRecipes.map((related) => (
							<li><a href={`/${related.id}`}>{related.data.title}</a></li>
						))}
					</ul>
				</section>
			)}
		</article>
	</main>

	<script>
		function initCheckboxes() {
			const contentContainer = document.querySelector('.e-content');
			if (!contentContainer) return;

			const checkboxes = contentContainer.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
			if (checkboxes.length === 0) return;

			const resetBtn = document.getElementById('reset-checklist-btn');
			if (resetBtn) {
				resetBtn.hidden = false;
			}

			const storageKey = `recipe-checkboxes-${window.location.pathname}`;
			let savedStates: Record<number, boolean> = {};

			try {
				const stored = localStorage.getItem(storageKey);
				if (stored) {
					savedStates = JSON.parse(stored);
				}
			} catch (e) {
				console.error('Failed to load checkbox states from localStorage', e);
			}

			checkboxes.forEach((checkbox, index) => {
				checkbox.disabled = false;
				checkbox.checked = Boolean(savedStates[index]);

				// The whole ingredient row is the hit target, not just the box (DESIGN.md).
				const row = checkbox.closest('.task-list-item');
				row?.addEventListener('click', (event) => {
					const target = event.target as HTMLElement;
					if (target === checkbox || target.closest('a, input, button')) return;
					// Clicks on nested notes under an ingredient don't toggle it.
					if (target.closest('ul, ol') !== row.parentElement) return;
					checkbox.checked = !checkbox.checked;
					checkbox.dispatchEvent(new Event('change'));
				});

				checkbox.addEventListener('change', () => {
					savedStates[index] = checkbox.checked;
					try {
						localStorage.setItem(storageKey, JSON.stringify(savedStates));
					} catch (e) {
						console.error('Failed to save checkbox states to localStorage', e);
					}
				});
			});

			if (resetBtn) {
				resetBtn.addEventListener('click', () => {
					checkboxes.forEach((checkbox, index) => {
						checkbox.checked = false;
						savedStates[index] = false;
					});
					try {
						localStorage.removeItem(storageKey);
					} catch (e) {
						console.error('Failed to clear checkbox states from localStorage', e);
					}
				});
			}
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initCheckboxes);
		} else {
			initCheckboxes();
		}
	</script>
</Layout>
